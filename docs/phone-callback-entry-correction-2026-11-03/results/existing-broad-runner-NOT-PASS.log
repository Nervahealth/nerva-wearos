    package health.hugr.sourcejournal
    
    import android.content.Context
    import android.system.Os
    import android.system.OsConstants
    import org.json.JSONArray
    import org.json.JSONObject
    import java.io.File
    import java.io.FileOutputStream
    import java.nio.charset.StandardCharsets
    import java.nio.file.Files
    import java.nio.file.LinkOption
    import java.security.MessageDigest
    import java.util.Base64
    
    internal const val RECEIPT_INCIDENT_DIAGNOSTIC_ROOT = "hugr_receipt_incident_diagnostics"
    private const val RECEIPT_INCIDENT_FILE_SUFFIX = ".hugr-incident"
    private const val RECEIPT_INCIDENT_MAX_REPORTS = 8
    /** Eight complete reports plus rendering delimiters must fit the one bounded share artifact. */
    internal const val RECEIPT_INCIDENT_MAX_BODY_BYTES = 48 * 1024
    internal const val RECEIPT_INCIDENT_MAX_RENDERED_BYTES = 1024 * 1024
    private const val RECEIPT_INCIDENT_MAX_ENVELOPE_BYTES = 66 * 1024
    private const val MAX_SAFE_JSON_INTEGER = 9_007_199_254_740_991L
    private const val V3_INCIDENT_FORMAT = "HUGR_PHONE_RECEIPT_INCIDENT_V3"
    private const val INCIDENT_FORMAT = "HUGR_PHONE_RECEIPT_INCIDENT_V2"
    private const val LEGACY_INCIDENT_FORMAT = "HUGR_PHONE_RECEIPT_INCIDENT_V1"
    private const val INCIDENT_FILE_FORMAT = "HUGR_PHONE_RECEIPT_INCIDENT_FILE_V1"
    private const val NATIVE_CORRELATION = "CORRELATION_UNRESOLVED"
    private const val NATIVE_CORRELATION_REASON = "BLE_PLX_TRANSACTION_ID_IS_NOT_ATT_REQUEST_ID_NO_EQUAL_COUNTER_OFFSET_OR_CLOCK_JOIN"
    private const val CRASH_UNCERTAINTY = "UNKNOWN_NOT_OBSERVABLE_NO_REPORT_IS_NOT_NON_ARRIVAL"
    private const val PUBLICATION_FORMAT = "HUGR_PHONE_RECEIPT_INCIDENT_PUBLICATION_V1"
    private const val PUBLICATION_CURRENT_BODY_COMMIT = "NOT_CLAIMED_BY_BODY_METADATA"
    private const val PUBLICATION_COMMIT_STATE = "ACKNOWLEDGED_ATOMIC_PUBLICATION_CHECKSUM_REOPEN_VERIFIED"
    
    /**
     * Payload-free, bounded Phone-local incident reports. This store is deliberately
     * independent of PhoneSourceJournal and PhoneCustodyRunReportStore: it neither
     * opens canonical evidence nor knows a Watch run/session, receipt body, ACK
     * hash, BLE address, or native ATT request ID.
     *
     * The JavaScript bridge invokes publication only after a local callback outcome
     * has been observed and never awaits it on a BLE deadline/response path. There
     * is no retry, timer, transport mutation, or wire behavior in this class.
     */
    internal data class ReceiptIncidentPublication(
      val incidentPseudonym: String,
      val revision: Long,
      val commitState: String,
      val acknowledgedAtomicPublication: Boolean,
      val reportBytes: Long,
    )
    
    internal interface ReceiptIncidentFileIo {
      fun writeAndSync(file: File, bytes: ByteArray)
      fun atomicReplace(from: File, to: File)
      fun syncDirectory(directory: File)
      fun readFully(file: File): ByteArray
    }
    
    internal object AndroidReceiptIncidentFileIo : ReceiptIncidentFileIo {
      override fun writeAndSync(file: File, bytes: ByteArray) {
        FileOutputStream(file).use { output ->
          output.write(bytes)
          output.flush()
          output.fd.sync()
        }
      }
    
      override fun atomicReplace(from: File, to: File) {
        Os.rename(from.absolutePath, to.absolutePath)
      }
    
      override fun syncDirectory(directory: File) {
        val descriptor = Os.open(directory.absolutePath, OsConstants.O_RDONLY, 0)
        try {
          check(OsConstants.S_ISDIR(Os.fstat(descriptor).st_mode)) { "Incident diagnostic directory descriptor is not a directory" }
          Os.fsync(descriptor)
        } finally {
          Os.close(descriptor)
        }
      }
    
      override fun readFully(file: File): ByteArray = file.readBytes()
    }
    
    internal class ReceiptIncidentDiagnosticStore(
      private val root: File,
      private val io: ReceiptIncidentFileIo = AndroidReceiptIncidentFileIo,
    ) {
      constructor(context: Context) : this(File(context.noBackupFilesDir, RECEIPT_INCIDENT_DIAGNOSTIC_ROOT))
    
      /**
       * temp write+fsync -> atomic replace -> directory fsync -> exact reopen/checksum
       * acknowledgement. A publication failure throws; callers do not retry. Thus a
       * missing report remains explicit pre-publication/crash uncertainty, never an
       * assertion of request non-arrival.
       */
      @Synchronized fun publish(snapshotJson: String): ReceiptIncidentPublication {
        val parsed = validateSnapshot(snapshotJson)
        if (parsed.format == V3_INCIDENT_FORMAT) ReceiptIncidentSafeLog.cause(parsed.incidentPseudonym, JSONObject(snapshotJson).getJSONObject("diagnosticContext").getJSONObject("firstCause"))
        ensureSafeRoot(create = true)
        check(interruptedTemporaryFiles().isEmpty()) { "RECEIPT_INCIDENT_INTERRUPTED_PUBLICATION_PRESENT" }
        val final = File(root, "incident-${parsed.incidentPseudonym}$RECEIPT_INCIDENT_FILE_SUFFIX")
        rejectUnsafeFile(final)
        if (!final.exists() && incidentFiles().size >= RECEIPT_INCIDENT_MAX_REPORTS) {
          throw IllegalStateException("RECEIPT_INCIDENT_STORE_CAPACITY_EXHAUSTED")
        }
        if (final.exists()) {
          val existing = reopen(final)
          check(existing.identity.incidentPseudonym == parsed.incidentPseudonym) { "RECEIPT_INCIDENT_FILE_IDENTITY_MISMATCH" }
          check(existing.identity.connectionEpoch == parsed.connectionEpoch &&
            existing.identity.firstFailure == parsed.firstFailure &&
            existing.identity.firstFailureAtMonotonicMs == parsed.firstFailureAtMonotonicMs &&
            existing.identity.format == parsed.format && existing.identity.frozenContext == parsed.frozenContext
          ) { "RECEIPT_INCIDENT_EPOCH_OR_FROZEN_CONTEXT_MISMATCH" }
          if (existing.identity.revision > parsed.revision) throw IllegalStateException("RECEIPT_INCIDENT_REVISION_REGRESSION")
          if (existing.identity.revision == parsed.revision) {
            if (existing.body != snapshotJson) throw IllegalStateException("RECEIPT_INCIDENT_SAME_REVISION_DIFFERENT_BODY")
            return ReceiptIncidentPublication(parsed.incidentPseudonym, parsed.revision, COMMIT_ACKNOWLEDGED, true, final.length())
          }
        }
        val temporary = File(root, ".incident-${parsed.incidentPseudonym}.${parsed.revision}.part")
        rejectUnsafeFile(temporary)
        if (temporary.exists()) throw IllegalStateException("RECEIPT_INCIDENT_TEMPORARY_COLLISION")
        try {
          io.writeAndSync(temporary, envelope(parsed, snapshotJson))
          io.atomicReplace(temporary, final)
          io.syncDirectory(root)
          val reopened = reopen(final)
          check(reopened.identity == parsed && reopened.body == snapshotJson) { "RECEIPT_INCIDENT_REOPEN_MISMATCH" }
          return ReceiptIncidentPublication(parsed.incidentPseudonym, parsed.revision, COMMIT_ACKNOWLEDGED, true, final.length())
        } catch (failure: Throwable) {
          if (temporary.exists() && !temporary.delete()) {
            // Do not hide the primary acknowledged-publication failure behind cleanup.
          }
          throw failure
        }
      }
    
      /**
       * Full bounded report set only. No latest fallback, no source/custody reader,
       * and no repair. A residual temp object is visible as a publication-loss state;
       * earlier valid reports remain readable rather than being silently hidden.
       */
      @Synchronized fun readAll(): String {
        ensureSafeRoot(create = false)
        if (!root.exists()) return renderNoSavedReports()
        val files = incidentFiles()
        check(files.size <= RECEIPT_INCIDENT_MAX_REPORTS) { "RECEIPT_INCIDENT_STORE_CAPACITY_EXHAUSTED" }
        val interrupted = interruptedTemporaryFiles()
        if (files.isEmpty() && interrupted.isEmpty()) return renderNoSavedReports()
        val reports = files.map(::reopen)
        val rendered = buildString {
          appendLine("HUGR SAVED RECEIPT DIAGNOSTICS")
          appendLine("mode=ISOLATED_NATIVE_RECEIPT_DIAGNOSTIC_READER")
          appendLine("react_main_ble_canonical_recovery=NO")
          appendLine("saved_incident_count=${reports.size}")
          appendLine("complete_reports=YES")
          appendLine("native_correlation=$NATIVE_CORRELATION")
          appendLine("native_correlation_reason=$NATIVE_CORRELATION_REASON")
          appendLine("absence_of_report_is_not_request_non_arrival=YES")
          if (interrupted.isNotEmpty()) {
            appendLine("publication_loss_state=INTERRUPTED_TEMPORARY_PUBLICATION_PRESENT")
            appendLine("interrupted_temporary_report_count=${interrupted.size}")
            appendLine("earlier_valid_reports_accessible=YES")
          } else {
            appendLine("publication_loss_state=NONE_OBSERVED")
          }
          reports.forEachIndexed { index, report ->
            appendLine("--- INCIDENT $index ---")
            appendLine("commit_state=${report.commitState}")
            appendLine("envelope_integrity=VERIFIED")
            appendLine("body_sha256=${report.bodySha256}")
            appendLine(report.body)
            appendLine("--- END INCIDENT $index ---")
            // Optional failure never hides or mutates a verified main. No live components are created.
            val native = try {
              ReceiptNativeWriteObservationStore(root, io, ReceiptNativeWriteVerifiedMainProvider(::verifiedNativeWriteMain))
                .read(nativeWriteMainOrNull(report))
            } catch (_: Throwable) { ReceiptNativeWriteRead("CORRUPT_OR_IDENTITY_MISMATCH") }
            append(native.renderForIsolatedReceiptReport())
          }
          appendLine("END REPORT")
        }
        check(rendered.toByteArray(StandardCharsets.UTF_8).size <= RECEIPT_INCIDENT_MAX_RENDERED_BYTES) {
          "RECEIPT_INCIDENT_RENDERED_REPORT_BOUND_INVALID"
        }
        return rendered
      }
    
      /** Locator only: reopen actual acknowledged V3 envelope/body every time; callers supply no authority. */
      @Synchronized fun verifiedNativeWriteMain(incidentPseudonym: String): ReceiptNativeWriteVerifiedMain {
        check(incidentPseudonym.matches(Regex("[A-Za-z0-9][A-Za-z0-9._-]{0,79}"))) { "RECEIPT_NATIVE_WRITE_INCIDENT_INVALID" }
        ensureSafeRoot(create = false)
        val report = reopen(File(root, "incident-$incidentPseudonym$RECEIPT_INCIDENT_FILE_SUFFIX"))
        check(report.identity.incidentPseudonym == incidentPseudonym) { "RECEIPT_NATIVE_WRITE_MAIN_IDENTITY_MISMATCH" }
        return nativeWriteMainOrNull(report) ?: throw IllegalStateException("RECEIPT_NATIVE_WRITE_REQUIRES_VERIFIED_V3")
      }
    
      private fun nativeWriteMainOrNull(report: ReopenedIncident): ReceiptNativeWriteVerifiedMain? {
        if (report.identity.format != V3_INCIDENT_FORMAT) return null
        val body = JSONObject(report.body)
        val operations = body.getJSONArray("operations")
        val exact = linkedSetOf<String>()
        for (index in 0 until operations.length()) {
          val transaction = operations.getJSONObject(index).get("localTransactionId")
          if (transaction is String) exact += transaction
        }
        val firstCause = body.getJSONObject("diagnosticContext").getJSONObject("firstCause")
        val reference = firstCause.getJSONObject("operationOrdinal")
        val failedTransactionId = if (reference.getString("state") == "VALUE") {
          val ordinal = reference.getLong("value")
          val operation = (0 until operations.length()).map(operations::getJSONObject)
            .single { it.getLong("localOrdinal") == ordinal }
          operation.get("localTransactionId") as? String
        } else {
          null
        }
        // No recency/counter/clock heuristic. Validation above establishes the exact retained join.
        return ReceiptNativeWriteVerifiedMain(
          ReceiptNativeWriteAnchor(report.identity.incidentPseudonym, report.identity.connectionEpoch,
            report.identity.firstFailure, report.identity.firstFailureAtMonotonicMs,
            sha256(canonical(firstCause).toByteArray(StandardCharsets.UTF_8))), exact.toSet(), failedTransactionId)
      }
    
      private fun isOptionalNativeSidecarName(name: String): Boolean =
        name.matches(Regex("native-write-[A-Za-z0-9][A-Za-z0-9._-]{0,79}\\.hugr-native-write")) ||
          name.matches(Regex("\\.native-write-[A-Za-z0-9][A-Za-z0-9._-]{0,79}\\.[1-9][0-9]{0,1}\\.part"))
    
      private fun renderNoSavedReports(): String = """HUGR SAVED RECEIPT DIAGNOSTICS
    mode=ISOLATED_NATIVE_RECEIPT_DIAGNOSTIC_READER
    react_main_ble_canonical_recovery=NO
    saved_incident_count=0
    outcome=NO_SAVED_INCIDENTS
    absence_of_report_is_not_request_non_arrival=YES
    crash_or_prepublication_loss=UNKNOWN
    END REPORT
    """
    
      private fun ensureSafeRoot(create: Boolean) {
        if (create && !root.exists() && !root.mkdirs()) throw IllegalStateException("RECEIPT_INCIDENT_ROOT_UNAVAILABLE")
        if (!root.exists()) return
        if (!root.isDirectory || Files.isSymbolicLink(root.toPath())) throw IllegalStateException("RECEIPT_INCIDENT_ROOT_UNSAFE")
      }
    
      private fun incidentFiles(): List<File> {
        if (!root.exists()) return emptyList()
        ensureSafeRoot(create = false)
        val entries = root.listFiles()?.toList() ?: throw IllegalStateException("RECEIPT_INCIDENT_DIRECTORY_UNREADABLE")
        val files = entries.filter { file ->
          if (isOptionalNativeSidecarName(file.name)) return@filter false
          rejectUnsafeFile(file)
          when {
            file.name.matches(INCIDENT_FILE_NAME) -> true
            file.name.matches(INTERRUPTED_TEMPORARY_NAME) -> false
            else -> throw IllegalStateException("RECEIPT_INCIDENT_DIRECTORY_ENTRY_INVALID")
          }
        }.sortedBy { it.name }
        return files
      }
    
      private fun interruptedTemporaryFiles(): List<File> {
        if (!root.exists()) return emptyList()
        ensureSafeRoot(create = false)
        return root.listFiles()?.toList()?.filter { file ->
          if (isOptionalNativeSidecarName(file.name)) return@filter false
          rejectUnsafeFile(file)
          file.name.matches(INTERRUPTED_TEMPORARY_NAME)
        }?.sortedBy { it.name } ?: throw IllegalStateException("RECEIPT_INCIDENT_DIRECTORY_UNREADABLE")
      }
    
      private fun rejectUnsafeFile(file: File) {
        if (Files.exists(file.toPath(), LinkOption.NOFOLLOW_LINKS) && (Files.isSymbolicLink(file.toPath()) || !file.isFile)) {
          throw IllegalStateException("RECEIPT_INCIDENT_OBJECT_UNSAFE")
        }
      }
    
      private data class SnapshotIdentity(
        val incidentPseudonym: String,
        val connectionEpoch: String,
        val revision: Long,
        val firstFailure: String,
        val firstFailureAtMonotonicMs: Long,
        val format: String,
        val frozenContext: String,
      )
      private data class ReopenedIncident(
        val identity: SnapshotIdentity,
        val commitState: String,
        val bodySha256: String,
        val body: String,
      )
    
      /** Actual JSON parsing, exact keys/types, and semantic bounds—not substring matching. */
      private fun validateSnapshot(body: String): SnapshotIdentity {
        val bytes = body.toByteArray(StandardCharsets.UTF_8)
        if (bytes.size !in 1..RECEIPT_INCIDENT_MAX_BODY_BYTES) throw IllegalArgumentException("RECEIPT_INCIDENT_BODY_SIZE_INVALID")
        val snapshot = strictObject(body, "RECEIPT_INCIDENT_BODY_NOT_JSON_OBJECT")
        val format = requiredString(snapshot, "format")
        when (format) {
          V3_INCIDENT_FORMAT -> requireExactKeys(snapshot, SNAPSHOT_KEYS + "diagnosticContext", "RECEIPT_INCIDENT_SCHEMA_INVALID")
          INCIDENT_FORMAT -> requireExactKeys(snapshot, SNAPSHOT_KEYS, "RECEIPT_INCIDENT_SCHEMA_INVALID")
          LEGACY_INCIDENT_FORMAT -> requireExactKeys(snapshot, LEGACY_SNAPSHOT_KEYS, "RECEIPT_INCIDENT_SCHEMA_INVALID")
          else -> throw IllegalStateException("RECEIPT_INCIDENT_SCHEMA_INVALID")
        }
        val pseudonym = requiredLocalToken(snapshot, "incidentPseudonym", "RECEIPT_INCIDENT_PSEUDONYM_INVALID")
        val epoch = requiredLocalToken(snapshot, "connectionEpoch", "RECEIPT_INCIDENT_EPOCH_INVALID")
        check(requiredLong(snapshot, "operationLimit") == 64L && requiredLong(snapshot, "lateSettlementReserve") == 8L) {
          "RECEIPT_INCIDENT_OPERATION_BOUND_INVALID"
        }
        val revision = requiredBoundedLong(snapshot, "revision", 1L, MAX_SAFE_JSON_INTEGER, "RECEIPT_INCIDENT_REVISION_INVALID")
        check(requiredBoolean(snapshot, "frozen")) { "RECEIPT_INCIDENT_NOT_FROZEN" }
        val firstFailure = requiredString(snapshot, "firstFailure")
        check(firstFailure in FIRST_FAILURES) { "RECEIPT_INCIDENT_FAILURE_INVALID" }
        val firstFailureAt = requiredBoundedLong(snapshot, "firstFailureAtMonotonicMs", 0L, MAX_SAFE_JSON_INTEGER, "RECEIPT_INCIDENT_FAILURE_TIME_INVALID")
        check(requiredString(snapshot, "nativeCorrelation") == NATIVE_CORRELATION &&
          requiredString(snapshot, "nativeCorrelationReason") == NATIVE_CORRELATION_REASON &&
          requiredString(snapshot, "crashBeforeCheckpoint") == CRASH_UNCERTAINTY
        ) { "RECEIPT_INCIDENT_CORRELATION_CONTRACT_INVALID" }
        if (format == INCIDENT_FORMAT || format == V3_INCIDENT_FORMAT) validatePublication(requiredObject(snapshot, "publication"), pseudonym, revision)
        validateOverflow(requiredObject(snapshot, "overflow"))
        val operations = requiredArray(snapshot, "operations")
        check(operations.length() <= 64) { "RECEIPT_INCIDENT_OPERATION_BOUND_INVALID" }
        var priorLocalOrdinal = 0L
        for (index in 0 until operations.length()) {
          val localOrdinal = validateOperation(operations.getJSONObject(index), pseudonym, epoch, format == V3_INCIDENT_FORMAT)
          check(localOrdinal > priorLocalOrdinal) { "RECEIPT_INCIDENT_OPERATION_ORDINAL_SEQUENCE_INVALID" }
          priorLocalOrdinal = localOrdinal
        }
        val frozenContext = if (format == V3_INCIDENT_FORMAT) validateDiagnosticContext(requiredObject(snapshot, "diagnosticContext"), operations) else ""
        return SnapshotIdentity(pseudonym, epoch, revision, firstFailure, firstFailureAt, format, frozenContext)
      }
    
      /**
       * Publication metadata never turns the present body into proof of its own
       * durability. Every acknowledgement or known-loss attempt must name a prior
       * body revision, while the native envelope/reopen establishes the current
       * body’s actual commit acknowledgement.
       */
      private fun validatePublication(publication: JSONObject, pseudonym: String, revision: Long) {
        requireExactKeys(publication, PUBLICATION_KEYS, "RECEIPT_INCIDENT_PUBLICATION_SCHEMA_INVALID")
        check(requiredString(publication, "format") == PUBLICATION_FORMAT &&
          requiredString(publication, "currentBodyCommit") == PUBLICATION_CURRENT_BODY_COMMIT
        ) { "RECEIPT_INCIDENT_PUBLICATION_SCHEMA_INVALID" }
        val acknowledgement = value(publication, "acknowledgement")
        if (acknowledgement != JSONObject.NULL) {
          check(acknowledgement is JSONObject) { "RECEIPT_INCIDENT_PUBLICATION_ACK_SCHEMA_INVALID" }
          requireExactKeys(acknowledgement, PUBLICATION_ACK_KEYS, "RECEIPT_INCIDENT_PUBLICATION_ACK_SCHEMA_INVALID")
          check(requiredLocalToken(acknowledgement, "incidentPseudonym", "RECEIPT_INCIDENT_PUBLICATION_ACK_IDENTITY_INVALID") == pseudonym &&
            requiredBoundedLong(acknowledgement, "revision", 1L, MAX_SAFE_JSON_INTEGER, "RECEIPT_INCIDENT_PUBLICATION_ACK_REVISION_INVALID") < revision &&
            requiredString(acknowledgement, "commitState") == PUBLICATION_COMMIT_STATE &&
            requiredBoolean(acknowledgement, "acknowledgedAtomicPublication")
          ) { "RECEIPT_INCIDENT_PUBLICATION_ACK_INVALID" }
        }
        val knownLoss = value(publication, "knownLoss")
        if (knownLoss != JSONObject.NULL) {
          check(knownLoss is JSONObject) { "RECEIPT_INCIDENT_PUBLICATION_LOSS_SCHEMA_INVALID" }
          requireExactKeys(knownLoss, PUBLICATION_LOSS_KEYS, "RECEIPT_INCIDENT_PUBLICATION_LOSS_SCHEMA_INVALID")
          check(requiredBoundedLong(knownLoss, "attemptedRevision", 1L, MAX_SAFE_JSON_INTEGER, "RECEIPT_INCIDENT_PUBLICATION_LOSS_REVISION_INVALID") < revision &&
            requiredString(knownLoss, "reason") in PUBLICATION_LOSS_REASONS
          ) { "RECEIPT_INCIDENT_PUBLICATION_LOSS_INVALID" }
        }
      }
    
      private fun validateOverflow(overflow: JSONObject) {
        requireExactKeys(overflow, OVERFLOW_KEYS, "RECEIPT_INCIDENT_OVERFLOW_SCHEMA_INVALID")
        val evicted = requiredBoundedLong(overflow, "evictedCompletedRows", 0L, MAX_SAFE_JSON_INTEGER, "RECEIPT_INCIDENT_OVERFLOW_INVALID")
        val lost = requiredBoundedLong(overflow, "lostNewOperations", 0L, MAX_SAFE_JSON_INTEGER, "RECEIPT_INCIDENT_OVERFLOW_INVALID")
        val lateLost = requiredBoundedLong(overflow, "lateSettlementWithoutRetainedRow", 0L, MAX_SAFE_JSON_INTEGER, "RECEIPT_INCIDENT_OVERFLOW_INVALID")
        check(requiredBoolean(overflow, "traceWindowOverflow") == (evicted > 0L || lost > 0L || lateLost > 0L)) {
          "RECEIPT_INCIDENT_OVERFLOW_INVALID"
        }
      }
    
      private fun validateOperation(operation: JSONObject, pseudonym: String, epoch: String, compactV3: Boolean): Long {
        val required = if (compactV3) COMPACT_V3_OPERATION_REQUIRED_KEYS else OPERATION_REQUIRED_KEYS
        val optional = if (compactV3) COMPACT_V3_OPERATION_OPTIONAL_KEYS else OPERATION_OPTIONAL_KEYS
        requireAllowedKeys(operation, required + optional, "RECEIPT_INCIDENT_OPERATION_SCHEMA_INVALID")
        check(required.all(operation::has)) { "RECEIPT_INCIDENT_OPERATION_SCHEMA_INVALID" }
        if (!compactV3) {
          check(requiredLocalToken(operation, "connectionEpoch", "RECEIPT_INCIDENT_OPERATION_EPOCH_INVALID") == epoch &&
            requiredLocalToken(operation, "incidentPseudonym", "RECEIPT_INCIDENT_OPERATION_PSEUDONYM_INVALID") == pseudonym
          ) { "RECEIPT_INCIDENT_OPERATION_IDENTITY_INVALID" }
        }
        // Compact V3 rows are scoped exclusively by the already validated root
        // pseudonym/epoch; redundant row identities are forbidden by exact keys.
        val localOrdinal = requiredBoundedLong(operation, "localOrdinal", 1L, MAX_SAFE_JSON_INTEGER, "RECEIPT_INCIDENT_OPERATION_ORDINAL_INVALID")
        val kind = requiredString(operation, "operationKind")
        check(kind in OPERATION_KINDS) { "RECEIPT_INCIDENT_OPERATION_KIND_INVALID" }
        val transaction = value(operation, "localTransactionId")
        check(transaction == JSONObject.NULL || transaction is String && transaction.matches(LOCAL_TRANSACTION_ID)) {
          "RECEIPT_INCIDENT_LOCAL_TRANSACTION_ID_INVALID"
        }
        if (operation.has("pageOffset")) {
          // The offset is the preceding bounded R1 page-request metadata; the
          // paired RECEIPT_READ carries the same request offset, never a response
          // field or native/ATT identifier. No other operation kind may carry it.
          check(kind == "R1_WRITE" || kind == "RECEIPT_READ") { "RECEIPT_INCIDENT_PAGE_OFFSET_KIND_INVALID" }
          requiredBoundedLong(operation, "pageOffset", 0L, 999_999L, "RECEIPT_INCIDENT_PAGE_OFFSET_INVALID")
        }
        requiredBoundedLong(operation, "jsSubmittedAtMonotonicMs", 0L, MAX_SAFE_JSON_INTEGER, "RECEIPT_INCIDENT_OPERATION_TIME_INVALID")
        val pending = requiredBoolean(operation, "pending")
        val deadline = requiredBoolean(operation, "deadlineObserved")
        val disconnect = requiredBoolean(operation, "disconnectObserved")
        val settled = optionalBoundedLong(operation, "settledAtMonotonicMs", 0L, MAX_SAFE_JSON_INTEGER, "RECEIPT_INCIDENT_OPERATION_TIME_INVALID")
        val timely = optionalEnum(operation, "timelySettlement", TIMELY_SETTLEMENTS, "RECEIPT_INCIDENT_TIMELY_SETTLEMENT_INVALID")
        val cancellation = optionalEnum(operation, "cancellation", CANCELLATIONS, "RECEIPT_INCIDENT_CANCELLATION_INVALID")
        val late = optionalEnum(operation, "lateSettlement", LATE_SETTLEMENTS, "RECEIPT_INCIDENT_LATE_SETTLEMENT_INVALID")
        check(requiredString(operation, "nativeAttDispatch") == "UNKNOWN") { "RECEIPT_INCIDENT_NATIVE_DISPATCH_INVALID" }
        if (pending) check(settled == null && timely == null && !deadline && !disconnect && late == null) { "RECEIPT_INCIDENT_PENDING_STATE_INVALID" }
        if (timely != null) check(!pending && !deadline && settled != null) { "RECEIPT_INCIDENT_TIMELY_STATE_INVALID" }
        if (deadline) check(!pending && settled != null && timely == null) { "RECEIPT_INCIDENT_DEADLINE_STATE_INVALID" }
        if (late != null) check(deadline && !pending) { "RECEIPT_INCIDENT_LATE_STATE_INVALID" }
        if (cancellation != null) check(deadline) { "RECEIPT_INCIDENT_CANCELLATION_STATE_INVALID" }
        return localOrdinal
      }
    
      private fun validateDiagnosticContext(context: JSONObject, operations: JSONArray): String {
        requireExactKeys(context, setOf("firstCause","preceding","subsequent","lastSuccessfulStage","contextOverflow","processLoss"), "RECEIPT_INCIDENT_CONTEXT_SCHEMA_INVALID")
        check(requiredString(context,"processLoss") == "UNKNOWN_NOT_OBSERVABLE") { "RECEIPT_INCIDENT_PROCESS_LOSS_INVALID" }
        val refs = (0 until operations.length()).map { requiredLong(operations.getJSONObject(it), "localOrdinal") }.toSet()
        val first = requiredObject(context,"firstCause")
        val firstOrdinal = validateObservation(first, refs, true)
        check(requiredString(first,"outcome") != "SUCCEEDED") { "RECEIPT_INCIDENT_FIRST_CAUSE_SUCCESS_INVALID" }
        validateTag(requiredObject(first,"lastSuccessfulStage"), "stage")
        validateTag(requiredObject(context,"lastSuccessfulStage"), "stage")
        check(canonical(requiredObject(first,"lastSuccessfulStage")) == canonical(requiredObject(context,"lastSuccessfulStage"))) { "RECEIPT_INCIDENT_PRIOR_SUCCESS_MUTATED" }
        val preceding = requiredArray(context,"preceding")
        val subsequent = requiredArray(context,"subsequent")
        check(preceding.length() <= 16 && subsequent.length() <= 16) { "RECEIPT_INCIDENT_CONTEXT_BOUND_INVALID" }
        var prior = 0L
        for (i in 0 until preceding.length()) {
          val n = validateObservation(preceding.getJSONObject(i), refs, false)
          check(n > prior && n < firstOrdinal) { "RECEIPT_INCIDENT_CONTEXT_ORDINAL_INVALID" }
          prior = n
        }
        prior = firstOrdinal
        for (i in 0 until subsequent.length()) {
          val n = validateObservation(subsequent.getJSONObject(i), refs, false)
          check(n > prior) { "RECEIPT_INCIDENT_CONTEXT_ORDINAL_INVALID" }
          prior = n
        }
        val overflow = requiredObject(context,"contextOverflow")
        requireExactKeys(overflow,setOf("precedingEvicted","subsequentDropped","truncated"),"RECEIPT_INCIDENT_CONTEXT_OVERFLOW_INVALID")
        val evicted = requiredBoundedLong(overflow,"precedingEvicted",0L,MAX_SAFE_JSON_INTEGER,"RECEIPT_INCIDENT_CONTEXT_OVERFLOW_INVALID")
        val dropped = requiredBoundedLong(overflow,"subsequentDropped",0L,MAX_SAFE_JSON_INTEGER,"RECEIPT_INCIDENT_CONTEXT_OVERFLOW_INVALID")
        check(requiredBoolean(overflow,"truncated") == (evicted > 0 || dropped > 0)) { "RECEIPT_INCIDENT_CONTEXT_OVERFLOW_INVALID" }
    
        return canonical(first) + ":" + canonical(preceding) + ":" + evicted
      }
    
      private fun validateObservation(observation: JSONObject, refs: Set<Long>, first: Boolean): Long {
        val keys = setOf("ordinal","atMonotonicMs","operationOrdinal","stage","outcome","origin","error","classifier","lifecycle")
        requireExactKeys(observation, if (first) keys + "lastSuccessfulStage" else keys, "RECEIPT_INCIDENT_OBSERVATION_SCHEMA_INVALID")
        val ordinal = requiredBoundedLong(observation,"ordinal",1L,MAX_SAFE_JSON_INTEGER,"RECEIPT_INCIDENT_CONTEXT_ORDINAL_INVALID")
        validateTag(requiredObject(observation,"atMonotonicMs"), "time")
        val ref = requiredObject(observation,"operationOrdinal")
        validateTag(ref,"reference")
        if (requiredString(ref,"state") == "VALUE") check(requiredLong(ref,"value") in refs) { "RECEIPT_INCIDENT_CONTEXT_REFERENCE_INVALID" }
        check(requiredString(observation,"stage") in DIAGNOSTIC_STAGES && requiredString(observation,"outcome") in DIAGNOSTIC_OUTCOMES && requiredString(observation,"origin") in DIAGNOSTIC_ORIGINS) { "RECEIPT_INCIDENT_OBSERVATION_ENUM_INVALID" }
        validateTag(requiredObject(observation,"classifier"), "classifier")
        validateTag(requiredObject(observation,"lifecycle"), "lifecycle")
        val error = requiredObject(observation,"error")
        requireExactKeys(error,setOf("libraryCategory","errorCode","attErrorCode","androidErrorCode"),"RECEIPT_INCIDENT_ERROR_SCHEMA_INVALID")
        for (key in listOf("errorCode","attErrorCode","androidErrorCode")) validateTag(requiredObject(error,key),"number")
        val category = requiredObject(error,"libraryCategory")
        validateTag(category,"category")
        val code = requiredObject(error,"errorCode")
        val state = requiredString(code,"state")
        if (state == "VALUE") {
          val expected = BLE_CATEGORIES[requiredLong(code,"value")]
          if (expected == null) check(requiredString(category,"state") == "UNKNOWN") { "RECEIPT_INCIDENT_CATEGORY_CODE_MISMATCH" }
          else check(requiredString(category,"state") == "VALUE" && requiredString(category,"value") == expected) { "RECEIPT_INCIDENT_CATEGORY_CODE_MISMATCH" }
        } else check(requiredString(category,"state") == state) { "RECEIPT_INCIDENT_CATEGORY_CODE_MISMATCH" }
        return ordinal
      }
    
      private fun validateTag(tag: JSONObject, kind: String) {
        val state = requiredString(tag,"state")
        check(state in setOf("VALUE","ABSENT","INVALID","UNKNOWN")) { "RECEIPT_INCIDENT_TAG_STATE_INVALID" }
        requireExactKeys(tag, if (state == "VALUE") setOf("state","value") else setOf("state"), "RECEIPT_INCIDENT_TAG_SCHEMA_INVALID")
        if (kind == "reference") check(state == "VALUE" || state == "UNKNOWN") { "RECEIPT_INCIDENT_CONTEXT_REFERENCE_INVALID" }
        if (state != "VALUE") return
        when(kind) {
          "number" -> requiredBoundedLong(tag,"value",-MAX_SAFE_JSON_INTEGER,MAX_SAFE_JSON_INTEGER,"RECEIPT_INCIDENT_NUMBER_INVALID")
          "time" -> requiredBoundedLong(tag,"value",0L,MAX_SAFE_JSON_INTEGER,"RECEIPT_INCIDENT_TIME_INVALID")
          "reference" -> requiredBoundedLong(tag,"value",1L,MAX_SAFE_JSON_INTEGER,"RECEIPT_INCIDENT_CONTEXT_REFERENCE_INVALID")
          "category" -> check(requiredString(tag,"value") in BLE_CATEGORIES.values) { "RECEIPT_INCIDENT_CATEGORY_INVALID" }
          "stage" -> check(requiredString(tag,"value") in DIAGNOSTIC_SUCCESS_STAGES) { "RECEIPT_INCIDENT_PRIOR_STAGE_INVALID" }
          "classifier" -> check(requiredString(tag,"value") in DIAGNOSTIC_CLASSIFIERS) { "RECEIPT_INCIDENT_CLASSIFIER_INVALID" }
          "lifecycle" -> check(requiredString(tag,"value") in setOf("ACTIVE","BACKGROUND","INACTIVE")) { "RECEIPT_INCIDENT_LIFECYCLE_INVALID" }
        }
      }
    
      /** Deterministic full semantic comparison, independent of JSON key order; no extra keys admitted. */
      private fun canonical(value: Any): String = when(value) {
        is JSONObject -> objectKeys(value).sorted().joinToString(prefix="{",postfix="}") { JSONObject.quote(it)+":"+canonical(value.get(it)) }
        is JSONArray -> (0 until value.length()).joinToString(prefix="[",postfix="]") { canonical(value.get(it)) }
        is String -> JSONObject.quote(value)
        else -> value.toString()
      }
    
      private fun envelope(identity: SnapshotIdentity, body: String): ByteArray {
        val encoded = Base64.getEncoder().encodeToString(body.toByteArray(StandardCharsets.UTF_8))
        val digest = sha256(body.toByteArray(StandardCharsets.UTF_8))
        return ("{\"format\":\"$INCIDENT_FILE_FORMAT\",\"incident_pseudonym\":\"${identity.incidentPseudonym}\",\"revision\":${identity.revision},\"body_sha256\":\"$digest\",\"body_base64\":\"$encoded\",\"commit_state\":\"$COMMIT_ACKNOWLEDGED\"}\n")
          .toByteArray(StandardCharsets.UTF_8)
      }
    
      private fun reopen(file: File): ReopenedIncident {
        rejectUnsafeFile(file)
        val bytes = io.readFully(file)
        if (bytes.size !in 1..RECEIPT_INCIDENT_MAX_ENVELOPE_BYTES) throw IllegalStateException("RECEIPT_INCIDENT_FILE_SIZE_INVALID")
        val envelope = strictObject(String(bytes, StandardCharsets.UTF_8).trim(), "RECEIPT_INCIDENT_ENVELOPE_INVALID")
        requireExactKeys(envelope, ENVELOPE_KEYS, "RECEIPT_INCIDENT_ENVELOPE_SCHEMA_INVALID")
        val format = requiredString(envelope, "format")
        val pseudonym = requiredLocalToken(envelope, "incident_pseudonym", "RECEIPT_INCIDENT_ENVELOPE_SCHEMA_INVALID")
        val revision = requiredBoundedLong(envelope, "revision", 1L, MAX_SAFE_JSON_INTEGER, "RECEIPT_INCIDENT_ENVELOPE_SCHEMA_INVALID")
        val digest = requiredString(envelope, "body_sha256")
        check(digest.matches(Regex("[0-9a-f]{64}"))) { "RECEIPT_INCIDENT_ENVELOPE_SCHEMA_INVALID" }
        val encoded = requiredString(envelope, "body_base64")
        val state = requiredString(envelope, "commit_state")
        if (format != INCIDENT_FILE_FORMAT || state != COMMIT_ACKNOWLEDGED) throw IllegalStateException("RECEIPT_INCIDENT_ENVELOPE_SCHEMA_INVALID")
        val bodyBytes = try { Base64.getDecoder().decode(encoded) }
        catch (_: IllegalArgumentException) { throw IllegalStateException("RECEIPT_INCIDENT_BODY_ENCODING_INVALID") }
        check(Base64.getEncoder().encodeToString(bodyBytes) == encoded) { "RECEIPT_INCIDENT_BODY_ENCODING_INVALID" }
        val body = try { String(bodyBytes, StandardCharsets.UTF_8) }
        catch (_: Exception) { throw IllegalStateException("RECEIPT_INCIDENT_BODY_ENCODING_INVALID") }
        val validated = validateSnapshot(body)
        if (validated.incidentPseudonym != pseudonym || validated.revision != revision || sha256(bodyBytes) != digest) {
          throw IllegalStateException("RECEIPT_INCIDENT_ENVELOPE_INTEGRITY_INVALID")
        }
        return ReopenedIncident(validated, state, digest, body)
      }
    
      private fun strictObject(raw: String, code: String): JSONObject = try {
        StrictJsonDuplicateKeyScanner(raw).verify()
        JSONObject(raw)
      } catch (_: Exception) {
        throw IllegalArgumentException(code)
      }
    
      private fun requireExactKeys(value: JSONObject, expected: Set<String>, code: String) {
        val actual = objectKeys(value)
        check(actual == expected) { code }
      }
    
      private fun requireAllowedKeys(value: JSONObject, allowed: Set<String>, code: String) {
        check(objectKeys(value).all { it in allowed }) { code }
      }
    
      private fun objectKeys(value: JSONObject): Set<String> = buildSet {
        val iterator = value.keys()
        while (iterator.hasNext()) add(iterator.next())
      }
    
      private fun value(value: JSONObject, key: String): Any {
        check(value.has(key)) { "RECEIPT_INCIDENT_SCHEMA_INVALID" }
        return value.get(key)
